{
  "expo": {
    "name": "Onze",
    "slug": "onze-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "onze",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.onze.organizadordepelada",
      "icon": "./assets/icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#148A4A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o Onze use a biometria para entrar na sua conta."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o Onze acesse suas fotos para escolher a imagem do grupo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
