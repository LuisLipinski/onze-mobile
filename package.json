{
  "name": "onze-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/write-app-icon.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/*.test.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:coverage:check": "node --test scripts/coverage-core.test.mjs",
    "test:components": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:components": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint app src scripts tests tamagui.config.ts jest.config.cjs --max-warnings=0",
    "format": "prettier --write app src scripts tests tamagui.config.ts eslint.config.cjs jest.config.cjs",
    "format:check": "prettier --check app src scripts tests tamagui.config.ts eslint.config.cjs jest.config.cjs"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@tamagui/config": "2.7.7",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.15",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-sse": "1.2.1",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "2.7.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-jest": "29.7.0",
    "eslint": "~9.39.5",
    "eslint-config-expo": "~57.0.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "jest": "29.7.0",
    "jest-environment-node": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "^3.9.9",
    "test-renderer": "1.1.0",
    "typescript": "~6.0.3"
  }
}
